+    assert_eq!(v["dry_run"], false, "{v}");
+    assert_eq!(v["branch"], "odm", "{v}");
+    assert!(v["store_root"].is_string(), "{v}");
+    assert_eq!(v["upstream"]["ref"], "origin/odm", "{v}");
+    assert_eq!(v["upstream"]["ahead"], 0, "{v}");
