+    if json {
+        let gates = load_gate_config(root).ok().map(|(g, _)| g);
+        writeln!(
+            out,
+            "{}",
+            serde_json::to_string_pretty(&NodeJson::with_gates(&doc, gates.as_ref()))?
+        )?;
+        return Ok(());
+    }
+    term::success(err, &format!("set {field}={value:?} on #{number} {name:?}"))?;
+    Ok(())
