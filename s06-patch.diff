+    assert_eq!(branch_oid(bare.path(), "odm"), branch_oid(&store, "HEAD"));
+}
+
+#[test]
+fn dry_run_reports_in_plain_text_too() {
+    let (dir, bare) = bootstrapped_store_with_upstream();
